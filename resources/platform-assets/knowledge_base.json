   "id": "CRZ-01",
   "defect": "crazing",
   "defect_cn": "龟裂",
   "dimension": "equipment",
   "root_cause": "轧制温度偏低导致热塑性不足",
   "conditions": [
    {
     "field": "roll_temp",
     "op": "<",
     "value": 1100
    }
   ],
   "solution": "出炉温度由当前值提升至 1180-1230℃，并检查加热炉均热段温控",
   "expected_drop_pct": 28
  },
  {
